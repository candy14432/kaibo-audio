{%- assign panel = section.settings.card_bg -%}
{%- if panel == 'light' -%}
  {%- assign panel_bg = '#fff' -%}{%- assign panel_eyebrow = '#8A8A8F' -%}
  {%- assign panel_title = '#0B0B0C' -%}{%- assign panel_body = '#57575C' -%}
{%- else -%}
  {%- assign panel_bg = '#141416' -%}{%- assign panel_eyebrow = '#8E8E93' -%}
  {%- assign panel_title = '#FAFAFA' -%}{%- assign panel_body = '#8E8E93' -%}
{%- endif -%}

<section id="{{ section.settings.anchor }}" data-theme="dark" style="background:#0B0B0C;padding:120px 0;color:#FAFAFA">
  <div class="pad" style="max-width:1320px;margin:0 auto;padding:0 44px">
    <div class="sys-head" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:80px;align-items:end;margin-bottom:64px">
      <div>
        <div style="color:#6E6E73;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;margin-bottom:22px">{{ section.settings.eyebrow }}</div>
        <h2 style="margin:0;color:#FAFAFA;font-size:clamp(40px,4vw,56px);line-height:1.02;font-weight:700;letter-spacing:-0.04em">{{ section.settings.heading }}</h2>
      </div>
      <p style="margin:0 0 6px;color:#8E8E93;font-size:17px;line-height:1.62">{{ section.settings.body }}</p>
    </div>

    {%- for block in section.blocks -%}{%- if block.type == 'feature' -%}
    <div class="cards feature" style="display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:0;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1)" {{ block.shopify_attributes }}>
      <div data-reveal="" style="background:{{ panel_bg }};display:flex;align-items:center;justify-content:center;padding:44px 40px">
        <img loading="lazy" decoding="async" src="{{ block.settings.image | asset_url }}" alt="{{ block.settings.title }}" style="width:100%;max-width:620px;height:auto;display:block">
      </div>
      <div data-reveal="" style="background:{{ panel_bg }};padding:32px 30px 36px;display:flex;flex-direction:column;justify-content:center">
        <div style="color:{{ panel_eyebrow }};font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;margin-bottom:18px">{{ block.settings.eyebrow }}</div>
        <h3 style="margin:0 0 16px;color:{{ panel_title }};font-size:clamp(28px,2.4vw,36px);line-height:1.08;font-weight:700;letter-spacing:-0.03em">{{ block.settings.title }}</h3>
        <p style="margin:0;color:{{ panel_body }};font-size:16px;line-height:1.62">{{ block.settings.body }}</p>
      </div>
    </div>
    {%- endif -%}{%- endfor -%}

    <div class="cards" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);border-top:none">
      {%- for block in section.blocks -%}{%- if block.type == 'product' -%}
      <div data-reveal="" style="background:#fff;padding:32px 30px 36px" {{ block.shopify_attributes }}>
        <div style="height:180px;margin-bottom:28px"><img loading="lazy" decoding="async" src="{{ block.settings.image | asset_url }}" alt="{{ block.settings.title }}" style="width:100%;height:100%;object-fit:contain;display:block"></div>
        <h3 style="margin:0 0 10px;color:#0B0B0C;font-size:20px;font-weight:700;letter-spacing:-0.02em">{{ block.settings.title }}</h3>
        <p style="margin:0;color:#57575C;font-size:15px;line-height:1.6">{{ block.settings.body }}</p>
      </div>
      {%- endif -%}{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kaibo products",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "products" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Products" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "body", "label": "Body" },
    { "type": "select", "id": "card_bg", "label": "Lead card panel", "options": [
      { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }], "default": "dark" }
  ],
  "blocks": [
    { "type": "feature", "name": "Lead product", "limit": 1, "settings": [
      { "type": "text", "id": "image", "label": "Image file name" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "inline_richtext", "id": "body", "label": "Body" }
    ]},
    { "type": "product", "name": "Product", "settings": [
      { "type": "text", "id": "image", "label": "Image file name" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "inline_richtext", "id": "body", "label": "Body" }
    ]}
  ],
  "presets": [{ "name": "Kaibo products" }]
}
{% endschema %}
