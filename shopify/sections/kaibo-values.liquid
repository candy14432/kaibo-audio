<section id="{{ section.settings.anchor }}" data-theme="dark" style="background:#0B0B0C;padding:120px 0;color:#FAFAFA">
  <div class="pad" style="max-width:1320px;margin:0 auto;padding:0 44px">
    <div class="sys-head" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:80px;align-items:end;margin-bottom:64px">
      <div>
        <div style="color:#6E6E73;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;margin-bottom:22px">{{ section.settings.eyebrow }}</div>
        <h2 style="margin:0;color:#FAFAFA;font-size:clamp(40px,4vw,56px);line-height:1.02;font-weight:700;letter-spacing:-0.04em">{{ section.settings.heading }}</h2>
      </div>
      <p style="margin:0 0 6px;color:#8E8E93;font-size:17px;line-height:1.62">{{ section.settings.body }}</p>
    </div>
    <div class="cards" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1)">
      {%- for block in section.blocks -%}
      <div data-reveal="" style="background:#141416;padding:40px 34px 42px" {{ block.shopify_attributes }}>
        <h3 style="margin:0 0 12px;color:#FAFAFA;font-size:20px;font-weight:700;letter-spacing:-0.02em">{{ block.settings.title }}</h3>
        <p style="margin:0;color:#8E8E93;font-size:15px;line-height:1.6">{{ block.settings.body }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kaibo values",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "values" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we stand for" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "body", "label": "Body" }
  ],
  "blocks": [
    { "type": "value", "name": "Value", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "inline_richtext", "id": "body", "label": "Body" }
    ]}
  ],
  "presets": [{ "name": "Kaibo values" }]
}
{% endschema %}
