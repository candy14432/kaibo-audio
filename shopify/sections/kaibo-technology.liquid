<section id="{{ section.settings.anchor }}" data-theme="light" class="snap" style="box-sizing:border-box;background:#F6F6F4;padding:120px 0;color:#0B0B0C;min-height:100vh;min-height:100dvh;display:flex;align-items:center">
  <div class="pad tech-grid" style="width:100%;max-width:1320px;margin:0 auto;padding:0 44px;display:grid;grid-template-columns:minmax(0,0.85fr) minmax(0,1.15fr);gap:96px">
    <div>
      <div style="color:#8A8A8F;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;margin-bottom:22px">{{ section.settings.eyebrow }}</div>
      <h2 style="margin:0;color:#0B0B0C;font-size:clamp(40px,4vw,56px);line-height:1.02;font-weight:700;letter-spacing:-0.04em">{{ section.settings.heading }}</h2>
      <p style="margin:26px 0 0;color:#57575C;font-size:17px;line-height:1.62">{{ section.settings.body }}</p>
    </div>
    <div class="tech-cards" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;border:1px solid #E4E4E1;align-self:center">
      {%- for block in section.blocks -%}
      <div style="padding:38px 32px 42px" {{ block.shopify_attributes }}>
        {%- if block.settings.illustration != blank -%}
        <img loading="lazy" decoding="async" src="{{ block.settings.illustration | asset_url }}" alt="" aria-hidden="true" style="width:80%;height:fit-content;display:block;margin-bottom:22px">
        {%- endif -%}
        <div style="color:#0B0B0C;font-size:16px;font-weight:600;margin-bottom:10px">{{ block.settings.title }}</div>
        <p style="margin:0;color:#57575C;font-size:15px;line-height:1.6">{{ block.settings.body }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kaibo technology",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "technology" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technology" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "body", "label": "Body" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "illustration", "label": "Illustration file name", "info": "An SVG in the theme's assets folder" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "inline_richtext", "id": "body", "label": "Body" }
    ]}
  ],
  "presets": [{ "name": "Kaibo technology" }]
}
{% endschema %}
