{%- comment -%}
  A film is named by its file in Content > Files, but a pasted CDN link works
  too: anything already containing a host is used as it stands.
{%- endcomment -%}
{%- assign film = section.settings.video -%}
{%- unless film contains '//' or film == blank -%}{%- assign film = film | file_url -%}{%- endunless -%}
{%- comment -%}
  The banner is a still on some pages and a film on others, so the observer
  hook only goes on when there is something to play.
{%- endcomment -%}
<section class="snap"{% if section.settings.video != blank %} data-play-in-view=""{% endif %} style="position:relative;height:100vh;height:100dvh;min-height:680px;overflow:hidden;background:#000">
  <div class="kb-hero-media" style="position:absolute;inset:0;background-image:url({{ section.settings.poster | asset_url }});background-size:cover;background-position:{{ section.settings.focus }};transform:scale(1);transform-origin:50% 45%;will-change:transform">
    {%- if section.settings.video != blank -%}
    <video src="{{ film }}" muted loop playsinline autoplay poster="{{ section.settings.poster | asset_url }}" preload="auto"{% if section.settings.start != blank %} data-start="{{ section.settings.start }}"{% endif %} style="width:100%;height:100%;object-fit:cover;display:block"></video>
    {%- endif -%}
  </div>
  {%- comment -%}
    Each banner carries its own scrim: a bright sky needs a different fall of
    darkness from a dim room, and the copy has to stay readable on both.
  {%- endcomment -%}
  <div style="position:absolute;inset:0;background:{{ section.settings.overlay }};pointer-events:none"></div>
  <div class="kb-hero-copy" style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;pointer-events:none;opacity:1">
    <div class="pad" style="max-width:1320px;width:100%;margin:0 auto;padding:0 44px 88px">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;animation:fadeIn 900ms ease both 200ms">
        <span style="color:#C7C7CC;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase">{{ section.settings.eyebrow }}</span>
      </div>
      <h1 style="margin:0;max-width:15ch;color:#fff;font-size:clamp(52px,7vw,104px);line-height:0.95;font-weight:700;letter-spacing:-0.045em;text-wrap:balance;animation:riseIn 1000ms cubic-bezier(0.16,1,0.3,1) both 320ms">{{ section.settings.heading }}</h1>
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:60px;margin-top:36px;animation:riseIn 1000ms cubic-bezier(0.16,1,0.3,1) both 520ms">
        <p style="margin:0;max-width:{{ section.settings.body_width }};color:#C7C7CC;font-size:19px;line-height:1.55">{{ section.settings.body }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kaibo hero",
  "settings": [
    { "type": "text", "id": "video", "label": "Video file name", "info": "Uploaded to Content > Files. Leave empty for a still banner." },
    { "type": "text", "id": "poster", "label": "Image file name", "info": "The film's poster, or the photograph itself when there is no film" },
    { "type": "text", "id": "focus", "label": "Crop focus", "default": "center", "info": "A CSS background-position value, e.g. center or 58% 45%" },
    { "type": "text", "id": "start", "label": "Start the video at (seconds, optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "body_width", "label": "Body width", "default": "46ch" },
    { "type": "textarea", "id": "overlay", "label": "Scrim", "info": "A CSS background value laid over the banner", "default": "linear-gradient(to bottom,rgba(0,0,0,0.5) 0%,rgba(0,0,0,0.12) 42%,rgba(11,11,12,0.45) 88%,rgba(11,11,12,0.8) 100%)" }
  ],
  "presets": [{ "name": "Kaibo hero" }]
}
{% endschema %}
