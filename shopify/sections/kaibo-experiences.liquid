<section id="{{ section.settings.anchor }}" data-theme="light" style="background:#F6F6F4;padding:120px 0;color:#0B0B0C">
  <div class="pad" style="max-width:1320px;margin:0 auto;padding:0 44px">
    <div class="sys-head" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:80px;align-items:end;margin-bottom:64px">
      <div>
        <div style="color:#8A8A8F;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;margin-bottom:22px">{{ section.settings.eyebrow }}</div>
        <h2 style="margin:0;color:#0B0B0C;font-size:clamp(40px,4vw,56px);line-height:1.02;font-weight:700;letter-spacing:-0.04em">{{ section.settings.heading }}</h2>
      </div>
      <p style="margin:0 0 6px;color:#57575C;font-size:17px;line-height:1.62">{{ section.settings.body }}</p>
    </div>
    <div class="cards" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#E4E4E1;border:1px solid #E4E4E1">
      {%- for block in section.blocks -%}
      <a class="kb-card-link" data-reveal="" href="{{ block.settings.url }}" style="display:block;background:#fff;text-decoration:none" {{ block.shopify_attributes }}>
        <div class="kb-card-media" style="aspect-ratio:16/10;background:#141416;background-image:url({{ block.settings.image | asset_url }});background-size:cover;background-position:center"></div>
        <div style="padding:34px 34px 40px">
          <h3 style="margin:0 0 12px;color:#0B0B0C;font-size:20px;font-weight:700;letter-spacing:-0.02em">{{ block.settings.title }}</h3>
          <p style="margin:0;color:#57575C;font-size:15px;line-height:1.6">{{ block.settings.body }}</p>
          <span class="kb-card-go">{{ block.settings.link_label }}<span class="kb-card-arrow" aria-hidden="true">&#8594;</span></span>
        </div>
      </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kaibo experiences",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "experiences" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we make" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "body", "label": "Body" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "image", "label": "Image file name" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "inline_richtext", "id": "body", "label": "Body" },
      { "type": "url", "id": "url", "label": "Links to" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" }
    ]}
  ],
  "presets": [{ "name": "Kaibo experiences" }]
}
{% endschema %}
