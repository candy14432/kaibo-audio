{%- comment -%}
  About has no .scene band for the bar to watch, so this names itself as the
  last dark ground before the light bands below.
{%- endcomment -%}
<section id="{{ section.settings.anchor }}" data-header-solid-after="" style="background:#0B0B0C;padding:120px 0">
  <div class="pad" style="max-width:1320px;margin:0 auto;padding:0 44px">
    <div class="sys-head" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:80px;align-items:end;margin-bottom:72px">
      <div>
        <div style="color:#6E6E73;font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;margin-bottom:22px">{{ section.settings.eyebrow }}</div>
        <h2 style="margin:0;color:#FAFAFA;font-size:clamp(40px,4vw,56px);line-height:1.02;font-weight:700;letter-spacing:-0.04em">{{ section.settings.heading }}</h2>
      </div>
      <p style="margin:0 0 6px;color:#8E8E93;font-size:17px;line-height:1.62">{{ section.settings.body }}</p>
    </div>
    <div class="kb-timeline">
      {%- for block in section.blocks -%}
      <div class="kb-tl-item" data-reveal="" {{ block.shopify_attributes }}>
        <span class="kb-tl-rail" aria-hidden="true"></span>
        <div class="kb-tl-year">{{ block.settings.year }}{% if block.settings.tag != blank %}<span class="kb-tl-tag">{{ block.settings.tag }}</span>{% endif %}</div>
        <h3 style="margin:0 0 12px;color:#FAFAFA;font-size:24px;font-weight:700;letter-spacing:-0.025em">{{ block.settings.heading }}</h3>
        <p style="margin:0;max-width:56ch;color:#8E8E93;font-size:17px;line-height:1.62">{{ block.settings.body }}</p>
        {%- if block.settings.image != blank -%}
        <div class="kb-tl-media">
          <img loading="lazy" decoding="async" src="{{ block.settings.image | asset_url }}" alt="{{ block.settings.image_alt }}" style="width:100%;height:100%;object-fit:cover;display:block">
        </div>
        {%- endif -%}
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kaibo story",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "story" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "body", "label": "Body" }
  ],
  "blocks": [
    { "type": "milestone", "name": "Milestone", "settings": [
      { "type": "text", "id": "year", "label": "Year" },
      { "type": "text", "id": "tag", "label": "Tag", "info": "Such as Upcoming. Leave empty for past milestones." },
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "inline_richtext", "id": "body", "label": "Body" },
      { "type": "text", "id": "image", "label": "Image file name" },
      { "type": "text", "id": "image_alt", "label": "Image alt text" }
    ]}
  ],
  "presets": [{ "name": "Kaibo story" }]
}
{% endschema %}
