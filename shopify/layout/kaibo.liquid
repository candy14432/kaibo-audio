{%- comment -%}
  The Kaibo pages carry their own fixed bar and their own footer, so they are
  rendered on a bare layout rather than inside Narrative's chrome. Templates
  opt in with "layout": "kaibo".
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- comment -%}
    The homepage has no page title of its own, so it would otherwise fall back
    to the shop's SEO title, which is a product line rather than the company.
  {%- endcomment -%}
  {%- if request.page_type == 'index' -%}
  <title>Kaibo Audio</title>
  {%- else -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- endif -%}
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif -%}
  {{ content_for_header }}
</head>
<body>
  <div style="background:#0B0B0C">
    {{ content_for_layout }}
  </div>
</body>
</html>
